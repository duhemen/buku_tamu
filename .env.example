# ============================================================
# ENV CONTOH - Copy ke .env lalu sesuaikan
# ============================================================

# --- Umum ---
NODE_ENV=development
APP_NAME=Buku Tamu Digital
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://buku_tamu:buku_tamu_pass@localhost:5432/buku_tamu

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT & Security ---
JWT_SECRET=ganti_dengan_string_random_panjang_minimal_32_karakter
JWT_EXPIRES_IN=8h
ENCRYPTION_KEY=ganti_dengan_aes_256_key_32_byte_base64

# --- Storage (MinIO / S3) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=buku-tamu
STORAGE_REGION=us-east-1

# --- Face Service ---
FACE_SERVICE_URL=http://localhost:8000
FACE_THRESHOLD=0.6

# --- Printer (opsional) ---
PRINTER_THERMAL_WIDTH=58
