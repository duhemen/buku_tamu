{"name":"buku-tamu","version":"0.1.0","private":true,"description":"Aplikasi Buku Tamu Digital Terintegrasi","scripts":{"dev":"pnpm -r --parallel dev","build":"pnpm -r build","lint":"pnpm -r lint","test":"pnpm -r test","db:migrate":"pnpm --filter @buku-tamu/api prisma migrate dev","db:seed":"pnpm --filter @buku-tamu/api prisma db seed","db:generate":"pnpm --filter @buku-tamu/api prisma generate","docker:up":"docker compose up -d","docker:down":"docker compose down"},"engines":{"node":">=20.0.0","pnpm":">=9.0.0"}}